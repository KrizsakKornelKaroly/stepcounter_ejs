<%- include('../system/header') %>

    <div class="container bg-body-tertiary rounded-3 p-4 mt-4">

        <h2 class="text-center">Új lépésadat hozzáadása</h2>
        <div class="col-6 mx-auto">
            <%- include('../system/message') %>
        </div>

        <form action="/steps/new" method="POST" class="col-10 col-md-6 mx-auto my-4">

            <div class="form-floating mb-3">
                <input type="date" class="form-control" id="date" placeholder="" name="date" max="<%= moment().format('YYYY-MM-DD') %>">
                <label for="date">Dátum</label>
            </div>
            <div class="form-floating">
                <input type="number" class="form-control" id="steps" placeholder="" name="steps" min="1">
                <label for="steps">Lépésszám</label>
            </div>

            <input type="submit" value="Mentés" name="save" class="btn btn-outline-success btn-lg mt-3">

            <input type="button" value="Mégsem" name="cancel" class="btn btn-outline-secondary btn-lg mt-3 ms-2" onclick="window.location.href='/steps/steps'">


        </form>

        
    </div>

<%- include('../system/footer') %>
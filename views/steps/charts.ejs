<%- include('../system/header') %>

    <div class="container bg-body-tertiary rounded-3 p-4 mt-4">

        <h2 class="text-center">Statisztikák</h2>
        <div class="col-6 mx-auto">
            <%- include('../system/message') %>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-6 my-4 text-center">
                <h4>Az elmúlt 1 hét</h4>
                <canvas id="stepsWeekly"></canvas>
            </div>
            <div class="col-12 col-lg-6 my-4 text-center">
                <h4>Az elmúlt 1 hónap</h4>
                <canvas id="stepsMonthly"></canvas>
            </div>
            <div class="col-12 col-lg-10 my-4 text-center">
                <h4>Az elmúlt 1 év</h4>
                <canvas id="stepsYearly"></canvas>
            </div>
        </div>

    </div>

    <script>
        const stepsWeekly = document.getElementById('stepsWeekly');
        const stepsMonthly = document.getElementById('stepsMonthly');
        const stepsYearly = document.getElementById('stepsYearly');

        const stepDataWeek = <%- JSON.stringify(stepDataWeek) %> || [];
        const stepDataMonth = <%- JSON.stringify(stepDataMonth) %> || [];
        const stepDataYear = <%- JSON.stringify(stepDataYear) %> || [];

        const labelsYear = stepDataYear.map(item => item.date);
        const dataYear = stepDataYear.map(item => item.steps);

        const chartWeek = new Chart(stepsWeekly, {
            type: 'line',
            data: {
                labels: stepDataWeek.map(item => item.date),
                datasets: [{
                    label: 'Lépésszám',
                    data: stepDataWeek.map(item => item.steps),
                    fill: false,
                    borderColor: 'rgb(76, 175, 80)',
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        display: true,
                        title: { display: true, text: 'Dátum' }
                    },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Lépésszám' }
                    }
                }
            }
        });


        const chartMonth = new Chart(stepsMonthly, {
            type: 'line',
            data: {
                labels: stepDataMonth.map(item => item.date),
                datasets: [{
                    label: 'Lépésszám',
                    data: stepDataMonth.map(item => item.steps),
                    fill: false,
                    borderColor: 'rgb(76, 175, 80)',
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        display: true,
                        title: { display: true, text: 'Dátum' }
                    },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Lépésszám' }
                    }
                }
            }
        });


        const chartYear = new Chart(stepsYearly, {
            type: 'line',
            data: {
                labels: stepDataYear.map(item => item.date),
                datasets: [{
                    label: 'Lépésszám',
                    data: stepDataYear.map(item => item.steps),
                    fill: false,
                    borderColor: 'rgb(76, 175, 80)',
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        display: true,
                        title: { display: true, text: 'Dátum' }
                    },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Lépésszám' }
                    }
                }
            }
        });


        

    </script>

    <%- include('../system/footer') %>
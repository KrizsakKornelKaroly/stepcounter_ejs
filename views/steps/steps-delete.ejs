<%- include('../system/header') %>

    <div class="container bg-body-tertiary rounded-3 p-4 mt-4">

        <h2 class="text-center">Lépésadat törlése</h2>
        <div class="col-6 mx-auto">
            <%- include('../system/message') %>
        </div>

        <h3 class="mt-4">Biztosan törölni szeretnéd a következő lépésadatot?</h3>
        <div class="card col-12 col-md-6 col-xl-4 mx-auto my-4">
            <div class="card-body d-flex justify-content-center align-items-center flex-column">
                <h5 class="card-title">Dátum: <%= stepItem.date %></h5>
                <p class="card-text">Lépésszám: <%= stepItem.steps %> lépés</p>
                <form action="/steps/delete/<%= stepItem.id %>" method="POST">
                    <input type="submit" value="Törlés" name="delete" class="btn btn-outline-danger">
                    <a href="/steps/steps" class="btn btn-outline-secondary ms-2">Mégse</a>
                </form>
            </div>
        </div>
    </div>

<%- include('../system/footer') %>
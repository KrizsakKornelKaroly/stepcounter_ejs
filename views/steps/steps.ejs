<%- include('../system/header') %>

    <div class="container bg-body-tertiary rounded-3 p-4 mt-4">

        <h2 class="text-center">Lépéskezelő</h2>
        <div class="col-6 mx-auto">
            <%- include('../system/message') %>
        </div>

        <h3>Lépésadatok</h3>

        <% if (stepList.length === 0) { %>
            <p>Nincsenek rögzített lépésadatok.</p>
            <a href="/steps/add" class="btn btn-outline-success mt-3">Új lépésadat hozzáadása</a>
        <% } else { %>
            <div class="mb-3">
                <a href="/steps/add" class="btn btn-outline-success">Új lépésadat hozzáadása</a>

            </div>
        <% } %>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
            <% stepList.forEach((item, index) => { %>
                <div class="col d-flex">
                    <div class="card w-100">
                        <div class="card-body d-flex justify-content-center align-items-center flex-column">
                            <div>
                                <h5 class="card-title">Dátum: <%= item.date %></h5>
                                <p class="card-text">Lépésszám: <%= item.steps %> lépés</p>
                            </div>
                            <div class="mt-4">
                                <a href="/steps/edit/<%= item._id %>" class="btn btn-outline-warning me-2">Szerkesztés</a>
                                <a href="/steps/delete/<%= item._id %>" class="btn btn-outline-danger">Törlés</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    </div>
            
<%- include('../system/footer') %>